# Copy to .env and adjust. Nothing in this project requires secrets.

# The canonical SICKLE extraction.
# 209,039 .npz + 6,492 masks + sickle_dataset_tabular.csv
# csv md5 e804c1c165e3f55d03da8305a380ff77
SICKLE_DATA_ROOT=D:/FPD/sickledataset extracted

# NOT this one -- it is the TOY subset (19,859 npz, 651 masks) with a DIFFERENT
# csv (md5 0cb87468...). It loads without complaint and silently changes the
# evaluation set.
# SICKLE_DATA_ROOT=D:/FPD/WACV 2024

# Released checkpoints and training logs used by the reproduction gate.
SICKLE_RUNS=D:/FPD/runs/wacv_2024

# Interpreter used by scripts/*.sh and scripts/*.ps1.
SICKLE_PY=.venv/Scripts/python.exe
